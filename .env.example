# Vercel Global Config — copie para .env.local e preencha.

# URL de leitura dos itens (connection string do store + /items).
# Dashboard da Vercel → Storage → Global Config → seu store → Connection String.
VITE_GLOBAL_CONFIG_ITEMS="https://global-config.vercel.com/<id-do-store>/items?token=<token-de-leitura>"

# Id do store (começa com ecfg_):
GLOBAL_CONFIG_ID=

# Token de API da conta, necessário só para escrever (`pnpm catalog:push`).
# Crie em https://vercel.com/account/tokens — nunca commite este valor.
VERCEL_API_TOKEN=
